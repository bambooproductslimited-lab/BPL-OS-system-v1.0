# Copy to .env and fill in for local development.

# PostgreSQL connection. Either supply DATABASE_URL, or the discrete PG* vars below.
DATABASE_URL=postgres://bamboo:bamboo@localhost:5432/bamboo_os
# PGHOST=localhost
# PGPORT=5432
# PGUSER=bamboo
# PGPASSWORD=bamboo
# PGDATABASE=bamboo_os

# Set to "require" for managed Postgres (Render/Railway/Neon/Supabase/...) —
# see DEPLOYMENT.md. Leave unset for a local/self-hosted database.
# PGSSLMODE=require

PORT=4000
NODE_ENV=development

# JWT signing secret — generate a long random value for real deployments,
# e.g. `openssl rand -hex 32`. Never commit a real secret.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# HMAC pepper for kiosk PIN hashing/encryption (kiosk.service.js) — also
# generate a long random value, e.g. `openssl rand -hex 32`. Required to
# start the app when NODE_ENV=production (no insecure fallback in prod).
KIOSK_PIN_PEPPER=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call the API (the frontend's origin(s)).
CORS_ORIGIN=http://localhost:5173

# bcrypt cost factor
BCRYPT_ROUNDS=12

# AI Assistant (POST /api/ai/chat) — proxies to Anthropic's Messages API
# with a permission-scoped snapshot of company data as system context. Get
# a key at https://console.anthropic.com/. Left unset, the assistant still
# works (the chat UI loads and responds) but every reply is the same
# "not configured" message instead of a real answer — never commit a real key.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Cloudflare R2 (S3-compatible) storage for real Documents uploads/downloads
# (see src/lib/storage.js). Create a free R2 bucket + API token in the
# Cloudflare dashboard. Left unset, uploads are refused with a clear error
# instead of silently failing; existing document rows/metadata still work.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Square (POS/payments) — a one-time historical import into Customers,
# Catalog, Invoices and Payments (see src/services/squareImport.service.js),
# not a live sync. A single Production Access Token for your own Square
# seller account is enough — create one at
# https://developer.squareup.com/apps, no OAuth app needed. Left unset, the
# Integrations screen's "Run Square import" button stays disabled with a
# clear message.
# SQUARE_ACCESS_TOKEN=
# SQUARE_API_BASE_URL=https://connect.squareup.com

# Only used by `npm run bootstrap` (see DEPLOYMENT.md) — creates the first
# real administrator account on a freshly migrated production database.
# Not read anywhere else; safe to leave unset for local dev (which uses
# `npm run seed`'s fake demo accounts instead).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=
